{
  "name": "dotfiles-welcome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync-node-version": "node scripts/sync-node-version.mjs",
    "check-node-version": "node scripts/sync-node-version.mjs --check",
    "pretest": "npm run check-node-version",
    "welcome": "node scripts/tui/welcome/cli.mjs",
    "test": "node --test scripts/tui/welcome/*.test.mjs && bash scripts/tui/welcome/bridge.test.sh && bash scripts/install/latex.test.sh && bash scripts/bootstrap.test.sh"
  },
  "dependencies": {
    "ink": "7.1.0",
    "react": "19.2.7"
  },
  "devDependencies": {
    "ink-testing-library": "4.0.0"
  }
}
